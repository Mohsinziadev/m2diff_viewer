{
  "name": "m2diff-viewer",
  "version": "0.1.0",
  "description": "A multi-language code and data diff viewer for React: side-by-side, inline and unified views, word-level highlighting, folding, search, JSON/CSV structural diffs, and a framework-independent comparison engine.",
  "keywords": [
    "diff",
    "diff-viewer",
    "react",
    "code-review",
    "compare",
    "side-by-side",
    "unified-diff",
    "patch",
    "syntax-highlighting",
    "json-diff",
    "csv-diff",
    "text-diff",
    "merge",
    "typescript",
    "highlight.js",
    "shiki"
  ],
  "author": "Mohsin Zia <mohsinziadev@gmail.com>",
  "license": "MIT",
  "homepage": "https://www.m2toolkit.com/npm-packages/m2diff-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohsinziadev/m2diff_viewer.git"
  },
  "bugs": {
    "url": "https://github.com/Mohsinziadev/m2diff_viewer/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/react/index.cjs",
  "module": "./dist/react/index.js",
  "types": "./dist/react/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./highlight-js": {
      "import": {
        "types": "./dist/highlight-js/index.d.ts",
        "default": "./dist/highlight-js/index.js"
      },
      "require": {
        "types": "./dist/highlight-js/index.d.cts",
        "default": "./dist/highlight-js/index.cjs"
      }
    },
    "./shiki": {
      "import": {
        "types": "./dist/shiki/index.d.ts",
        "default": "./dist/shiki/index.js"
      },
      "require": {
        "types": "./dist/shiki/index.d.cts",
        "default": "./dist/shiki/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "node scripts/build.mjs && node scripts/build-css.mjs",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build:demo:dist": "M2DIFF_DEMO_DIST=1 vite build --config demo/vite.config.ts",
    "preview:demo": "vite preview --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node benchmarks/run.mjs",
    "size": "node scripts/size.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints ./styles.css",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:package && npm run size && npm run smoke",
    "prepublishOnly": "npm run verify",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "highlight.js": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.2.14",
    "rolldown-plugin-dts": "^0.28.8",
    "shiki": "^4.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
