{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"],
    "paths": {
      "m2diff-viewer": ["../src/react/index.ts"],
      "m2diff-viewer/core": ["../src/core/index.ts"],
      "m2diff-viewer/highlight-js": ["../src/highlight-js/index.ts"],
      "m2diff-viewer/shiki": ["../src/shiki/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../examples"]
}
